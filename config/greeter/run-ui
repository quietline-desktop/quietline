#!/bin/sh
# Контроль появления формы входа: после сигнала готовности ожидание пароля не ограничено.
ready="$QUIETLINE_GREETER_READY"
failed="$QUIETLINE_GREETER_FAILED"
rm -f "$ready"
qs -p /usr/share/quietline/shell/Greeter.qml &
ui=$!
(
    remaining=${QUIETLINE_GREETER_STARTUP_SECONDS:-15}
    while [ "$remaining" -gt 0 ]; do
        [ -e "$ready" ] && exit 0
        kill -0 "$ui" 2>/dev/null || exit 0
        sleep 1
        remaining=$((remaining - 1))
    done
    [ -e "$ready" ] && exit 0
    printf 'Quietline greeter did not show its form in time.\n' >&2
    touch "$failed"
    kill "$ui" 2>/dev/null || true
    sleep 2
    kill -KILL "$ui" 2>/dev/null || true
) &
watcher=$!
wait "$ui"
code=$?
kill "$watcher" 2>/dev/null || true
wait "$watcher" 2>/dev/null || true
if [ "$code" -ne 0 ] || [ ! -e "$ready" ]; then
    touch "$failed"
fi
hyprctl dispatch 'hl.dsp.exit()'
