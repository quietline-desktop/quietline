// Quietline: активный локальный пользователь из группы wheel применяет профили
// объекта, включает Wi-Fi, подтверждает и откатывает контрольные точки NetworkManager
// без запроса пароля. Удалённые и неактивные сеансы остаются с правилами дистрибутива.
polkit.addRule(function(action, subject) {
    var allowed = [
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.checkpoint-rollback",
        "org.freedesktop.NetworkManager.enable-disable-wifi"
    ];
    if (allowed.indexOf(action.id) >= 0 && subject.local && subject.active && subject.isInGroup("wheel"))
        return polkit.Result.YES;
});
