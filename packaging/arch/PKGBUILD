# Локальный пакет из клона Quietline. ./install.sh копирует этот файл в каталог сборки
# и задаёт QUIETLINE_REPO; в пакет попадает только закоммиченный код.
pkgname=quietline
pkgver=0.1.0.r155.ge6dfe07
pkgrel=1
pkgdesc="Quietline desktop: per-monitor Hyprland window engine and Quickshell shell"
arch=('any')
license=('GPL-3.0-only')
depends=('python' 'hyprland' 'quickshell' 'networkmanager' 'brightnessctl' 'power-profiles-daemon'
         'bluez' 'pipewire' 'wireplumber' 'glib2' 'libnotify' 'wl-clipboard' 'cliphist' 'grim'
         'slurp' 'satty' 'plocate' 'polkit' 'hypridle' 'inter-font' 'ttf-material-symbols-variable'
         'ttf-jetbrains-mono' 'capitaine-cursors' 'greetd' 'greetd-tuigreet')
makedepends=('git' 'python-build' 'python-installer' 'python-hatchling' 'grub' 'fontconfig')

_repo="${QUIETLINE_REPO:-$(realpath "$startdir/../..")}"

# <версия из pyproject>.r<число коммитов>.g<короткий хеш>: каждый новый коммит — новый пакет.
pkgver() {
    printf '%s.r%s.g%s' "$(sed -n 's/^version = "\(.*\)"/\1/p' "$_repo/pyproject.toml")" \
        "$(git -C "$_repo" rev-list --count HEAD)" "$(git -C "$_repo" rev-parse --short HEAD)"
}

prepare() {
    rm -rf "$srcdir/quietline"
    mkdir -p "$srcdir/quietline"
    git -C "$_repo" archive HEAD | tar -x -C "$srcdir/quietline"
}

build() {
    cd "$srcdir/quietline"
    python -m build --wheel --no-isolation --outdir "$srcdir/dist"
    # Тема меню GRUB: обои, капсула, шрифты .pf2 из Inter и JetBrains Mono, темы на двух языках.
    python config/grub/make-theme.py "$srcdir/grub-theme"
}

package() {
    cd "$srcdir/quietline"
    python -m installer --destdir="$pkgdir" "$srcdir"/dist/*.whl
    install -dm755 "$pkgdir/usr/share/quietline/shell"
    cp -r --no-preserve=ownership shell/quietline/. "$pkgdir/usr/share/quietline/shell/"
    install -Dm644 config/hyprland/quietline.lua "$pkgdir/usr/share/quietline/hyprland/quietline.lua"
    install -Dm644 config/hypridle/hypridle.conf "$pkgdir/usr/share/quietline/hypridle/hypridle.conf"
    install -Dm644 config/fish/quietline-locale.fish "$pkgdir/usr/share/quietline/fish/quietline-locale.fish"
    install -Dm644 config/polkit/50-quietline-network.rules "$pkgdir/usr/share/polkit-1/rules.d/50-quietline-network.rules"
    # Шрифт заголовков окон «Quietline Titlebar»: правило включается ссылкой в conf.default,
    # хук fontconfig переносит её в /etc/fonts/conf.d.
    install -Dm644 config/fontconfig/50-quietline-titlebar.conf "$pkgdir/usr/share/fontconfig/conf.avail/50-quietline-titlebar.conf"
    install -dm755 "$pkgdir/usr/share/fontconfig/conf.default"
    ln -s ../conf.avail/50-quietline-titlebar.conf "$pkgdir/usr/share/fontconfig/conf.default/50-quietline-titlebar.conf"
    # Экран входа: сценарий для greetd, Hyprland экрана входа и каталог его состояния.
    install -Dm755 config/greeter/quietline-greeter "$pkgdir/usr/bin/quietline-greeter"
    install -Dm644 config/greeter/hyprland.lua "$pkgdir/usr/share/quietline/greeter/hyprland.lua"
    install -Dm755 config/greeter/run-ui "$pkgdir/usr/share/quietline/greeter/run-ui"
    install -Dm644 config/greeter/quietline-greeter.conf "$pkgdir/usr/lib/tmpfiles.d/quietline-greeter.conf"
    install -dm755 "$pkgdir/usr/share/quietline/grub"
    install -m644 "$srcdir"/grub-theme/* "$pkgdir/usr/share/quietline/grub/"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
